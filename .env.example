# Copie para .env (ignorado pelo git). Sem segredos aqui.
HOST_PORT=8080
PORT=8080
DB_PATH=/app/data/detetive.db
BANCO3D_CACHE_FILE=/app/data/banco3d_places.json
# Admin inicial (só criado se ainda não houver admin). Sem ADMIN_PASSWORD, uma senha aleatória
# é gerada no 1º boot e gravada em /app/data/admin_password.txt (0600); o log mostra só o caminho.
ADMIN_USER=admin
ADMIN_PASSWORD=
